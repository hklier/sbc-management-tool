{
  "apiVersion": "v1",
  "kind": "Service",
  "spec": {
    "allocateLoadBalancerNodePorts": true,
    "externalTrafficPolicy": "Cluster",
    "internalTrafficPolicy": "Cluster",
    "ports": [
      {
        "name": "registry",
        "nodePort": 32531,
        "port": 5000,
        "protocol": "TCP",
        "targetPort": 5000
      }
    ],
    "selector": {
      "app": "registry"
    },
    "sessionAffinity": "None",
    "type": "LoadBalancer",
    "loadBalancerIP": "192.168.2.240"
  },
  "metadata": {
    "name": "registry",
    "namespace": "registry"
  }
}
