{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "spec": {
    "progressDeadlineSeconds": 600,
    "replicas": 1,
    "revisionHistoryLimit": 10,
    "selector": {
      "matchLabels": {
        "app": "registry"
      }
    },
    "strategy": {
      "type": "Recreate"
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "registry"
        }
      },
      "spec": {
        "containers": [
          {
            "env": [
              {
                "name": "REGISTRY_STORAGE_FILESYSTEM_ROOTDIRECTORY",
                "value": "/var/lib/registry"
              }
            ],
            "image": "docker.io/library/registry@sha256:a3d8aaa63ed8681a604f1dea0aa03f100d5895b6a58ace528858a7b332415373",
            "imagePullPolicy": "IfNotPresent",
            "name": "registry",
            "ports": [
              {
                "containerPort": 5000,
                "protocol": "TCP"
              }
            ],
            "resources": {},
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/var/lib/registry",
                "name": "registry-storage",
                "subPath": "data"
              }
            ],
            "readinessProbe": {
              "httpGet": {
                "path": "/v2/",
                "port": 5000
              },
              "periodSeconds": 5,
              "timeoutSeconds": 3,
              "failureThreshold": 3
            },
            "startupProbe": {
              "httpGet": {
                "path": "/v2/",
                "port": 5000
              },
              "periodSeconds": 3,
              "timeoutSeconds": 3,
              "failureThreshold": 30
            }
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "restartPolicy": "Always",
        "schedulerName": "default-scheduler",
        "securityContext": {},
        "terminationGracePeriodSeconds": 30,
        "volumes": [
          {
            "name": "registry-storage",
            "persistentVolumeClaim": {
              "claimName": "registry-storage-shared"
            }
          }
        ],
        "automountServiceAccountToken": false,
        "initContainers": [
          {
            "name": "verify-registry-data",
            "image": "docker.io/library/registry@sha256:a3d8aaa63ed8681a604f1dea0aa03f100d5895b6a58ace528858a7b332415373",
            "imagePullPolicy": "IfNotPresent",
            "command": [
              "/bin/sh",
              "-ec",
              "if [ \"$(cat /registry-check/.registry-volume-id 2>/dev/null)\" != \"$EXPECTED_REGISTRY_VOLUME_ID\" ]; then echo \"Refusing to start: expected registry data volume is missing or incorrect\" >&2; exit 1; fi; test -d /registry-check/docker/registry/v2/blobs"
            ],
            "env": [
              {
                "name": "EXPECTED_REGISTRY_VOLUME_ID",
                "value": "20261123T131823Z-5f677a"
              }
            ],
            "volumeMounts": [
              {
                "name": "registry-storage",
                "mountPath": "/registry-check",
                "subPath": "data",
                "readOnly": true
              }
            ]
          }
        ]
      }
    }
  },
  "metadata": {
    "name": "registry",
    "namespace": "registry",
    "annotations": {
      "registry.storage/migration-id": "20261123T131823Z-5f677a"
    }
  }
}
