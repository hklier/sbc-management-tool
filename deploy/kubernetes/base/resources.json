{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "sbc-management-tool"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolume",
      "metadata": {
        "name": "sbc-management-tool-worker2",
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=false,Delete=false"
        }
      },
      "spec": {
        "capacity": {
          "storage": "50Gi"
        },
        "accessModes": [
          "ReadWriteOnce"
        ],
        "persistentVolumeReclaimPolicy": "Retain",
        "storageClassName": "",
        "volumeMode": "Filesystem",
        "claimRef": {
          "name": "sbc-console-data",
          "namespace": "sbc-management-tool"
        },
        "hostPath": {
          "path": "/var/lib/sbc-management-tool",
          "type": "DirectoryOrCreate"
        },
        "nodeAffinity": {
          "required": {
            "nodeSelectorTerms": [
              {
                "matchExpressions": [
                  {
                    "key": "kubernetes.io/hostname",
                    "operator": "In",
                    "values": [
                      "k8s-worker2"
                    ]
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "sbc-console-data",
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=false,Delete=false"
        }
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "storageClassName": "",
        "volumeName": "sbc-management-tool-worker2",
        "resources": {
          "requests": {
            "storage": "50Gi"
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "sbc-console-config"
      },
      "data": {
        "BIND_HOST": "0.0.0.0",
        "PORT": "8443",
        "APP_USER": "admin",
        "STATE_DIR": "/var/lib/sbc-console",
        "RECORDING_DIR": "/var/lib/sbc-console/recordings",
        "TLS_CERT": "/etc/sbc-console/tls/tls.crt",
        "TLS_KEY": "/etc/sbc-console/tls/tls.key",
        "SBC_CA": "/etc/sbc-console/trust/sbc-ca.crt",
        "SBC_SSH_PORT": "22",
        "SNMP_VERSION": "3",
        "SNMP_AUTH_PROTOCOL": "SHA512",
        "SNMP_PRIV_PROTOCOL": "AES128",
        "SNMP_PORT": "161",
        "TRAP_BIND_HOST": "0.0.0.0",
        "TRAP_PORT": "1162",
        "SIP_HOST": "0.0.0.0",
        "INTERNAL_IP": "0.0.0.0",
        "EXTERNAL_IP": "192.168.0.241",
        "RTP_BIND_IP": "0.0.0.0",
        "PORTS": "5060",
        "UDP_PORTS": "5060",
        "TCP_PORTS": "5060",
        "RTP_PORT_MIN": "20000",
        "RTP_PORT_MAX": "20199",
        "SIP_IP_ACCESS_ENABLED": "false",
        "SIP_IP_DEFAULT_ALLOW": "true",
        "ENABLE_TLS": "false",
        "ENABLE_SRTP": "false",
        "BEHIND_NAT": "true",
        "HTTP_ENABLED": "false",
        "RECORDING_COMBINE_LEGS": "true",
        "RECORDING_FORMAT": "wav",
        "RECORDING_MAX_DURATION_HOURS": "4",
        "RECORDING_CLEANUP_DAYS": "36500",
        "RECORDING_STORAGE_ENABLED": "false",
        "MAX_CONCURRENT_CALLS": "10",
        "SUPPORTED_CODECS": "PCMU,PCMA",
        "SUPPORTED_VENDORS": "mock",
        "DEFAULT_SPEECH_VENDOR": "mock",
        "STT_DEFAULT_VENDOR": "mock",
        "GOOGLE_STT_ENABLED": "false",
        "STT_ASYNC_ENABLED": "false",
        "ENABLE_AUDIO_PROCESSING": "false",
        "AUDIO_PROCESSING_ENABLED": "false",
        "AUDIO_ENHANCEMENT_ENABLED": "false",
        "ENABLE_REDUNDANCY": "false",
        "DATABASE_ENABLED": "false",
        "CLUSTER_ENABLED": "false",
        "TRACING_ENABLED": "false",
        "LOG_LEVEL": "warn",
        "LOG_FORMAT": "json",
        "GOMEMLIMIT": "256MiB",
        "TRANSCRIPTION_PYTHON": "/usr/local/bin/python",
        "TRANSCRIPTION_MODEL": "/opt/sbc-transcription/model",
        "HF_HUB_OFFLINE": "1",
        "TRANSFORMERS_OFFLINE": "1",
        "OMP_NUM_THREADS": "1",
        "OPENBLAS_NUM_THREADS": "1"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "sbc-console"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "revisionHistoryLimit": 3,
        "selector": {
          "matchLabels": {
            "app": "sbc-console"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "sbc-console"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "nodeSelector": {
              "kubernetes.io/hostname": "k8s-worker2"
            },
            "securityContext": {
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "terminationGracePeriodSeconds": 90,
            "initContainers": [
              {
                "name": "data-permissions",
                "image": "sbc-console",
                "command": [
                  "python",
                  "-c",
                  "import os; p='/var/lib/sbc-console'; os.makedirs(p+'/recordings',exist_ok=True); [(os.chown(x,10001,10001),os.chmod(x,0o700)) for x in (p,p+'/recordings')]"
                ],
                "securityContext": {
                  "runAsUser": 0,
                  "runAsNonRoot": false,
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ],
                    "add": [
                      "CHOWN",
                      "FOWNER",
                      "DAC_OVERRIDE"
                    ]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/sbc-console"
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ]
              }
            ],
            "containers": [
              {
                "name": "console",
                "image": "sbc-console",
                "imagePullPolicy": "IfNotPresent",
                "command": [
                  "python",
                  "server.py"
                ],
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "sbc-console-config"
                    }
                  },
                  {
                    "secretRef": {
                      "name": "sbc-console-credentials"
                    }
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/sbc-console"
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "tls",
                    "mountPath": "/etc/sbc-console/tls",
                    "readOnly": true
                  },
                  {
                    "name": "sbc-ca",
                    "mountPath": "/etc/sbc-console/trust",
                    "readOnly": true
                  }
                ],
                "securityContext": {
                  "runAsUser": 10001,
                  "runAsGroup": 10001,
                  "runAsNonRoot": true,
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "512Mi"
                  }
                },
                "startupProbe": {
                  "exec": {
                    "command": [
                      "python",
                      "/opt/healthcheck.py",
                      "web"
                    ]
                  },
                  "periodSeconds": 15,
                  "timeoutSeconds": 5,
                  "failureThreshold": 20
                },
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "python",
                      "/opt/healthcheck.py",
                      "web"
                    ]
                  },
                  "periodSeconds": 15,
                  "timeoutSeconds": 5,
                  "failureThreshold": 4
                },
                "livenessProbe": {
                  "exec": {
                    "command": [
                      "python",
                      "/opt/healthcheck.py",
                      "web"
                    ]
                  },
                  "periodSeconds": 15,
                  "timeoutSeconds": 5,
                  "failureThreshold": 6
                },
                "ports": [
                  {
                    "name": "https",
                    "containerPort": 8443
                  }
                ]
              },
              {
                "name": "recorder",
                "image": "sbc-recorder",
                "imagePullPolicy": "IfNotPresent",
                "command": [
                  "python",
                  "recordings_supervisor.py"
                ],
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "sbc-console-config"
                    }
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/sbc-console"
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ],
                "securityContext": {
                  "runAsUser": 10001,
                  "runAsGroup": 10001,
                  "runAsNonRoot": true,
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "200m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "768Mi"
                  }
                },
                "startupProbe": {
                  "exec": {
                    "command": [
                      "python",
                      "/opt/healthcheck.py",
                      "recorder"
                    ]
                  },
                  "periodSeconds": 15,
                  "timeoutSeconds": 5,
                  "failureThreshold": 20
                },
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "python",
                      "/opt/healthcheck.py",
                      "recorder"
                    ]
                  },
                  "periodSeconds": 15,
                  "timeoutSeconds": 5,
                  "failureThreshold": 4
                },
                "livenessProbe": {
                  "exec": {
                    "command": [
                      "python",
                      "/opt/healthcheck.py",
                      "recorder"
                    ]
                  },
                  "periodSeconds": 15,
                  "timeoutSeconds": 5,
                  "failureThreshold": 6
                }
              },
              {
                "name": "transcription",
                "image": "sbc-transcription",
                "imagePullPolicy": "IfNotPresent",
                "command": [
                  "python",
                  "transcription_worker.py"
                ],
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "sbc-console-config"
                    }
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/sbc-console"
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ],
                "securityContext": {
                  "runAsUser": 10001,
                  "runAsGroup": 10001,
                  "runAsNonRoot": true,
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "200m",
                    "memory": "512Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "1Gi"
                  }
                },
                "startupProbe": {
                  "exec": {
                    "command": [
                      "python",
                      "/opt/healthcheck.py",
                      "transcription"
                    ]
                  },
                  "periodSeconds": 15,
                  "timeoutSeconds": 5,
                  "failureThreshold": 20
                },
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "python",
                      "/opt/healthcheck.py",
                      "transcription"
                    ]
                  },
                  "periodSeconds": 15,
                  "timeoutSeconds": 5,
                  "failureThreshold": 4
                },
                "livenessProbe": {
                  "exec": {
                    "command": [
                      "python",
                      "/opt/healthcheck.py",
                      "transcription"
                    ]
                  },
                  "periodSeconds": 15,
                  "timeoutSeconds": 5,
                  "failureThreshold": 6
                }
              },
              {
                "name": "traps",
                "image": "sbc-console",
                "imagePullPolicy": "IfNotPresent",
                "command": [
                  "python",
                  "trap_tools.py"
                ],
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "sbc-console-config"
                    }
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/sbc-console"
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ],
                "securityContext": {
                  "runAsUser": 10001,
                  "runAsGroup": 10001,
                  "runAsNonRoot": true,
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "256Mi"
                  }
                },
                "startupProbe": {
                  "exec": {
                    "command": [
                      "python",
                      "/opt/healthcheck.py",
                      "traps"
                    ]
                  },
                  "periodSeconds": 15,
                  "timeoutSeconds": 5,
                  "failureThreshold": 20
                },
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "python",
                      "/opt/healthcheck.py",
                      "traps"
                    ]
                  },
                  "periodSeconds": 15,
                  "timeoutSeconds": 5,
                  "failureThreshold": 4
                },
                "livenessProbe": {
                  "exec": {
                    "command": [
                      "python",
                      "/opt/healthcheck.py",
                      "traps"
                    ]
                  },
                  "periodSeconds": 15,
                  "timeoutSeconds": 5,
                  "failureThreshold": 6
                },
                "env": [
                  {
                    "name": "SBC_HOST",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "sbc-console-credentials",
                        "key": "SBC_HOST"
                      }
                    }
                  },
                  {
                    "name": "SNMP_TRAP_COMMUNITIES",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "sbc-console-credentials",
                        "key": "SNMP_TRAP_COMMUNITIES"
                      }
                    }
                  }
                ],
                "ports": [
                  {
                    "name": "traps",
                    "containerPort": 1162,
                    "protocol": "UDP"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "sbc-console-data"
                }
              },
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "512Mi"
                }
              },
              {
                "name": "tls",
                "secret": {
                  "secretName": "sbc-console-tls",
                  "defaultMode": 292
                }
              },
              {
                "name": "sbc-ca",
                "secret": {
                  "secretName": "sbc-console-trust",
                  "defaultMode": 292
                }
              }
            ]
          }
        }
      }
