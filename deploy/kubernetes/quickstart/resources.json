{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "sbc-console"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "sbc-console-state",
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=false,Delete=false"
        }
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "10Gi"
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "sbc-console"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "sbc-console"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "sbc-console"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "fsGroup": 10001,
              "fsGroupChangePolicy": "OnRootMismatch",
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "terminationGracePeriodSeconds": 30,
            "containers": [
              {
                "name": "console",
                "image": "sbc-console",
                "imagePullPolicy": "IfNotPresent",
                "command": [
                  "python",
                  "server.py"
                ],
                "env": [
                  {
                    "name": "STATE_DIR",
                    "value": "/data/application/state"
                  },
                  {
                    "name": "RECORDING_DIR",
                    "value": "/data/application/state/recordings"
                  },
                  {
                    "name": "BIND_HOST",
                    "value": "0.0.0.0"
                  },
                  {
                    "name": "PORT",
                    "value": "8443"
                  },
                  {
                    "name": "TRAP_BIND_HOST",
                    "value": "0.0.0.0"
                  },
                  {
                    "name": "TRAP_PORT",
                    "value": "1162"
                  },
                  {
                    "name": "POD_NAMESPACE",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "metadata.namespace"
                      }
                    }
                  }
                ],
                "securityContext": {
                  "runAsUser": 10001,
                  "runAsGroup": 10001,
                  "runAsNonRoot": true,
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "state",
                    "mountPath": "/data"
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ],
                "ports": [
                  {
                    "name": "https",
                    "containerPort": 8443,
                    "protocol": "TCP"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "512Mi"
                  }
                },
                "startupProbe": {
                  "exec": {
                    "command": [
                      "python",
                      "/opt/healthcheck.py",
                      "web"
                    ]
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 5,
                  "failureThreshold": 6
                },
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "python",
                      "/opt/healthcheck.py",
                      "web"
                    ]
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 5,
                  "failureThreshold": 6
                },
                "livenessProbe": {
                  "exec": {
                    "command": [
                      "python",
                      "/opt/healthcheck.py",
                      "web"
                    ]
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 5,
                  "failureThreshold": 6
                }
              },
              {
                "name": "traps",
                "image": "sbc-console",
                "imagePullPolicy": "IfNotPresent",
                "command": [
                  "python",
                  "trap_tools.py"
                ],
                "env": [
                  {
                    "name": "STATE_DIR",
                    "value": "/data/application/state"
                  },
                  {
                    "name": "RECORDING_DIR",
                    "value": "/data/application/state/recordings"
                  },
                  {
                    "name": "BIND_HOST",
                    "value": "0.0.0.0"
                  },
                  {
                    "name": "PORT",
                    "value": "8443"
                  },
                  {
                    "name": "TRAP_BIND_HOST",
                    "value": "0.0.0.0"
                  },
                  {
                    "name": "TRAP_PORT",
                    "value": "1162"
                  },
                  {
                    "name": "POD_NAMESPACE",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "metadata.namespace"
                      }
                    }
                  }
                ],
                "securityContext": {
                  "runAsUser": 10001,
                  "runAsGroup": 10001,
                  "runAsNonRoot": true,
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "state",
                    "mountPath": "/data"
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ],
                "ports": [
                  {
                    "name": "traps",
                    "containerPort": 1162,
                    "protocol": "UDP"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "25m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "256Mi"
                  }
                },
                "startupProbe": {
                  "exec": {
                    "command": [
                      "python",
                      "/opt/healthcheck.py",
                      "traps"
                    ]
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 5,
                  "failureThreshold": 6
                },
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "python",
                      "/opt/healthcheck.py",
                      "traps"
                    ]
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 5,
                  "failureThreshold": 6
                },
                "livenessProbe": {
                  "exec": {
                    "command": [
                      "python",
                      "/opt/healthcheck.py",
                      "traps"
                    ]
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 5,
                  "failureThreshold": 6
                }
              }
            ],
            "volumes": [
              {
                "name": "state",
                "persistentVolumeClaim": {
                  "claimName": "sbc-console-state"
                }
              },
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "128Mi"
                }
              }
            ],
            "initContainers": [
              {
                "name": "state-permissions",
                "image": "sbc-console",
                "command": [
                  "python",
                  "-c",
                  "import os; p='/data/application'; os.makedirs(p,mode=0o770,exist_ok=True); os.chown(p,-1,10001); os.chmod(p,0o770)"
                ],
                "securityContext": {
                  "runAsUser": 0,
                  "runAsGroup": 10001,
                  "runAsNonRoot": false,
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ],
                    "add": [
                      "CHOWN",
                      "FOWNER",
                      "DAC_OVERRIDE"
                    ]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "state",
                    "mountPath": "/data"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "10m",
                    "memory": "32Mi"
                  },
                  "limits": {
                    "cpu": "100m",
                    "memory": "64Mi"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "sbc-console"
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app.kubernetes.io/name": "sbc-console"
        },
        "ports": [
          {
            "name": "https",
            "port": 443,
            "targetPort": "https",
            "protocol": "TCP"
          },
          {
            "name": "traps",
            "port": 162,
            "targetPort": "traps",
            "protocol": "UDP"
          }
        ]
      }
    }
  ]
}
