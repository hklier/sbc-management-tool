{
  "apiVersion": "argoproj.io/v1alpha1",
  "kind": "Application",
  "metadata": {
    "name": "sbc-management-tool",
    "namespace": "argocd"
  },
  "spec": {
    "project": "default",
    "source": {
      "repoURL": "https://github.com/hklier/sbc-management-tool.git",
      "targetRevision": "main",
      "path": "deploy/kubernetes/base"
    },
    "destination": {
      "server": "https://kubernetes.default.svc",
      "namespace": "sbc-management-tool"
    },
    "syncPolicy": {
      "automated": {
        "prune": true,
        "selfHeal": true
      },
      "syncOptions": [
        "CreateNamespace=true"
      ],
      "retry": {
        "limit": 3,
        "backoff": {
          "duration": "10s",
          "factor": 2,
          "maxDuration": "2m"
        }
      }
    }
  }
}
